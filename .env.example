# Postgres connection string (Neon, Aiven, Render Postgres or a local Docker database)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interschool
# The email that owns the app. Whoever signs up with it gets Creator Control.
CREATOR_EMAIL=creator@example.org
# Long random string used to sign logins. Change it and everyone is signed out.
TOKEN_SECRET=change-me-to-a-long-random-string
PORT=3000
